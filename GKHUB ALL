local ActiveTabBtn = nil
local ActiveScrollFrame = nil

local function CreateScriptCard(parent, title, scriptUrl, imageId)
    local Card = Instance.new("Frame")
    Card.BackgroundColor3 = Color3.fromRGB(22, 27, 38)
    Card.BorderSizePixel = 0
    Card.Parent = parent

    local CardCorner = Instance.new("UICorner")
    CardCorner.CornerRadius = UDim.new(0, 8)
    CardCorner.Parent = Card

    local CardStroke = Instance.new("UIStroke")
    CardStroke.Color = Color3.fromRGB(40, 70, 115)
    CardStroke.Transparency = 0.6
    CardStroke.Parent = Card

    local Icon = Instance.new("ImageLabel")
    Icon.Size = UDim2.new(0, 42, 0, 42)
    Icon.Position = UDim2.fromOffset(8, 8)
    Icon.BackgroundColor3 = Color3.fromRGB(30, 36, 50)
    Icon.BorderSizePixel = 0
    Icon.Image = (imageId and imageId ~= "") and ("rbxassetid://" .. tostring(imageId)) or ""
    Icon.Parent = Card

    local IconCorner = Instance.new("UICorner")
    IconCorner.CornerRadius = UDim.new(0, 6)
    IconCorner.Parent = Icon

    local ScriptName = Instance.new("TextLabel")
    ScriptName.Size = UDim2.new(1, -60, 0, 20)
    ScriptName.Position = UDim2.fromOffset(56, 8)
    ScriptName.BackgroundTransparency = 1
    ScriptName.Text = title
    ScriptName.TextColor3 = Color3.fromRGB(235, 240, 250)
    ScriptName.TextSize = 11
    ScriptName.Font = Enum.Font.GothamMedium
    ScriptName.TextTruncate = Enum.TextTruncate.AtEnd
    ScriptName.TextXAlignment = Enum.TextXAlignment.Left
    ScriptName.Parent = Card

    local RunBtn = Instance.new("TextButton")
    RunBtn.Size = UDim2.new(1, -60, 0, 22)
    RunBtn.Position = UDim2.fromOffset(56, 28)
    RunBtn.BackgroundColor3 = Color3.fromRGB(30, 85, 160)
    RunBtn.BorderSizePixel = 0
    RunBtn.Text = "▶ รันสคริปต์"
    RunBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    RunBtn.TextSize = 10
    RunBtn.Font = Enum.Font.GothamBold
    RunBtn.AutoButtonColor = false
    RunBtn.Parent = Card

    local RunCorner = Instance.new("UICorner")
    RunCorner.CornerRadius = UDim.new(0, 5)
    RunCorner.Parent = RunBtn

    RunBtn.MouseButton1Click:Connect(function()
        RunBtn.Text = "กำลังรัน..."
        RunBtn.BackgroundColor3 = Color3.fromRGB(200, 140, 30)
        
        task.spawn(function()
            local success, err = pcall(function()
                local code = game:HttpGet(scriptUrl)
                if not code or code == "" then error("ดาวน์โหลดโค้ดล้มเหลว") end
                local func, loadErr = loadstring(code)
                if not func then error(loadErr) end
                func()
            end)

            if success then
                RunBtn.Text = "✔ สำเร็จ"
                RunBtn.BackgroundColor3 = Color3.fromRGB(40, 160, 80)
                task.wait(0.8)
                ScreenGui:Destroy()
            else
                RunBtn.Text = "✖ ข้อผิดพลาด"
                RunBtn.BackgroundColor3 = Color3.fromRGB(180, 50, 50)
                warn("[GK HUB Error]: " .. tostring(err))
                task.wait(1.5)
                RunBtn.Text = "▶ รันสคริปต์"
                RunBtn.BackgroundColor3 = Color3.fromRGB(30, 85, 160)
            end
        end)
    end)
end

for index, catData in ipairs(ScriptCategories) do
    local ScrollFrame = Instance.new("ScrollingFrame")
    ScrollFrame.Size = UDim2.fromScale(1, 1)
    ScrollFrame.BackgroundTransparency = 1
    ScrollFrame.BorderSizePixel = 0
    ScrollFrame.CanvasSize = UDim2.new(0, 0, 0, 0)
    ScrollFrame.ScrollBarThickness = 4
    ScrollFrame.ScrollBarImageColor3 = Color3.fromRGB(45, 110, 200)
    ScrollFrame.Visible = (index == 1)
    ScrollFrame.Parent = ContentContainer

    local GridLayout = Instance.new("UIGridLayout")
    GridLayout.CellSize = UDim2.fromOffset(220, 58)
    GridLayout.CellPadding = UDim2.fromOffset(8, 8)
    GridLayout.Parent = ScrollFrame

    GridLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        ScrollFrame.CanvasSize = UDim2.new(0, 0, 0, GridLayout.AbsoluteContentSize.Y + 10)
    end)

    for _, scriptInfo in ipairs(catData.Scripts) do
        CreateScriptCard(ScrollFrame, scriptInfo.Title, scriptInfo.Url, scriptInfo.ImageId)
    end

    local TabBtn = Instance.new("TextButton")
    TabBtn.Size = UDim2.fromOffset(130, 30)
    TabBtn.BackgroundColor3 = (index == 1) and Color3.fromRGB(30, 75, 140) or Color3.fromRGB(22, 27, 38)
    TabBtn.BorderSizePixel = 0
    TabBtn.Text = catData.Name
    TabBtn.TextColor3 = (index == 1) and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(150, 170, 190)
    TabBtn.TextSize = 11
    TabBtn.Font = Enum.Font.GothamBold
    TabBtn.Parent = TabContainer

    local TabBtnCorner = Instance.new("UICorner")
    TabBtnCorner.CornerRadius = UDim.new(0, 6)
    TabBtnCorner.Parent = TabBtn

    if index == 1 then
        ActiveTabBtn = TabBtn
        ActiveScrollFrame = ScrollFrame
    end

    TabBtn.MouseButton1Click:Connect(function()
        if ActiveTabBtn and ActiveScrollFrame then
            ActiveTabBtn.BackgroundColor3 = Color3.fromRGB(22, 27, 38)
            ActiveTabBtn.TextColor3 = Color3.fromRGB(150, 170, 190)
            ActiveScrollFrame.Visible = false
        end

        TabBtn.BackgroundColor3 = Color3.fromRGB(30, 75, 140)
        TabBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
        ScrollFrame.Visible = true

        ActiveTabBtn = TabBtn
        ActiveScrollFrame = ScrollFrame
    end)
end
